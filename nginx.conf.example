# ==============================================================================
# OX Tech - Production Nginx Server Block Configuration
# Place this configuration in /etc/nginx/sites-available/ox and link to sites-enabled
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name ox-tech.sa www.ox-tech.sa;

    # Redirect all HTTP requests to HTTPS (Production)
    # return 301 https://$host$request_uri;

    # Document Root must always point directly to the /public directory
    root /var/www/ox/public;

    index index.php index.html;
    charset utf-8;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Max Upload Size
    client_max_body_size 64M;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    # Clean Laravel URL Routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Laravel Front Controller
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Custom 404 handler
    error_page 404 /index.php;

    # PHP-FPM FastCGI Handler (PHP 8.4)
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        # For TCP sockets use:
        # fastcgi_pass 127.0.0.1:9000;
        
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;

        fastcgi_hide_header X-Powered-By;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 64k;
        fastcgi_temp_file_write_size 64k;
        fastcgi_read_timeout 60;
    }

    # Static Assets & 3D Models High Performance Cache
    location ~* \.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2|ttf|glb|gltf)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, no-transform";
    }

    # Block access to hidden files (.env, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Block access to build & config files
    location ~* \.(env|git|lock|json|yml|yaml|md|txt)$ {
        deny all;
    }
}
